# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Local/Compose database credentials
POSTGRES_USER=riskuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=riskregister

# Backend (localhost URL is only for bare-metal dev; Compose builds its own from the above)
DATABASE_URL=postgresql+psycopg2://riskuser:CHANGE_ME@localhost:5432/riskregister
SEED_ON_STARTUP=true
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend (dev proxy target)
VITE_API_PROXY=http://localhost:8000

# AWS (deployment only - see docs/aws-deployment.md)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=CHANGE_ME
BACKEND_HOST=backend